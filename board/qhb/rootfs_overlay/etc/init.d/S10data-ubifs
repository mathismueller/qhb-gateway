#!/bin/sh
# Mount persistent /data on mtd17 (UBIFS) if already provisioned,
# otherwise fall back to tmpfs (guarantees zero NAND writes during TFTP testing).

DATA_MTD_NAME="bundles"
DATA_DIR="/data"
DEFAULT_CONF="/etc/qhb/qhb.conf.default"

find_mtd_index() {
    awk -F: -v name="\"$1\"" '$0 ~ name {gsub(/mtd/, "", $1); print $1; exit}' /proc/mtd
}

mount_tmpfs() {
    mount -t tmpfs -o size=16m tmpfs "$DATA_DIR"
}

start() {
    mkdir -p "$DATA_DIR" /var/log /var/run

    if grep -q "qhb.tmpfs=1" /proc/cmdline 2>/dev/null; then
        mount_tmpfs
    else
        MTD_IDX="$(find_mtd_index "$DATA_MTD_NAME" || true)"
        if [ -n "$MTD_IDX" ] && command -v ubiattach >/dev/null 2>&1; then
            if ubiattach -m "$MTD_IDX" -d 0 >/dev/null 2>&1 && [ -e /dev/ubi0_0 ]; then
                mount -t ubifs ubi0:qhb_data "$DATA_DIR" || mount_tmpfs
            else
                mount_tmpfs
            fi
        else
            mount_tmpfs
        fi
    fi

    mkdir -p "$DATA_DIR/ssh" "$DATA_DIR/pairing"
    if [ ! -f "$DATA_DIR/qhb.conf" ] && [ -f "$DEFAULT_CONF" ]; then
        cp "$DEFAULT_CONF" "$DATA_DIR/qhb.conf"
    fi

    # Persist Dropbear host keys across reboots when /data is UBIFS
    rm -rf /etc/dropbear
    ln -s "$DATA_DIR/ssh" /etc/dropbear
}

case "${1:-start}" in
    start)
        start
        ;;
    stop)
        umount "$DATA_DIR" 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
