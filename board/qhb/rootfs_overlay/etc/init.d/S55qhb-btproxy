#!/bin/sh
# S55qhb-btproxy: ESPHome Bluetooth Proxy daemon (TCP 6053)

if [ -f /data/qhb.conf ]; then
    # shellcheck source=/dev/null
    . /data/qhb.conf
fi
[ "${QHB_BT_ENABLE:-1}" = "1" ] || exit 0

DAEMON="/usr/sbin/qhb-btproxy"
PIDFILE="/var/run/qhb-btproxy.pid"

case "${1:-}" in
    start)
        for _ in 1 2 3 4 5; do
            [ -d /sys/class/bluetooth/hci0 ] && break
            sleep 1
        done
        [ -d /sys/class/bluetooth/hci0 ] || exit 1
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
        ;;
    stop)
        start-stop-daemon -K -p "$PIDFILE" 2>/dev/null || true
        rm -f "$PIDFILE"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
